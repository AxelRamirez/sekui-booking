# Stripe sandbox (test mode) keys — https://dashboard.stripe.com/test/apikeys
# Leave STRIPE_SECRET_KEY empty to use the built-in simulated checkout.
STRIPE_SECRET_KEY=sk_test_...
# Optional: signing secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL used for Stripe redirect URLs and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the JSON database lives (defaults to ./.data)
# DATA_DIR=.data
